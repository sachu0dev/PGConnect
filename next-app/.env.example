# =============================================================================
# PGConnect web app (next-app) — environment variables
# Copy to `.env` and fill in. [REQUIRED] = the app refuses to start in
# production without it. [OPTIONAL] features switch off gracefully when unset.
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time.
# =============================================================================

# ----------------------------------------------------------------------------
# Core
# ----------------------------------------------------------------------------
# [REQUIRED] Postgres connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pgconnect"
# [OPTIONAL] Only for `prisma migrate dev` (local schema changes).
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pgconnect_shadow"

# [REQUIRED] Signs 15-minute access tokens (HS256). Use 32+ random bytes:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The socket server must use the SAME value.
JWT_SECRET=""

# [REQUIRED in production] Public origin, no trailing slash. Used for canonical
# URLs, sitemap, Open Graph and links in emails. (build time + runtime)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# [OPTIONAL] Comma-separated emails that get admin access (/admin) on top of
# users flagged isAdmin in the database.
ADMIN_EMAILS=""

# ----------------------------------------------------------------------------
# File storage (listing photos + private ID documents)
# STORAGE_DRIVER chooses where NEW uploads go: "local" (default) or "s3".
# Files already stored by the other driver keep working after you switch
# (keep the AWS_* vars set if you ever stored files in S3).
#   local: files live in STORAGE_LOCAL_DIR (default ./storage); photos are
#          served at /uploads/*. Use a persistent disk/volume in production.
#   s3:    needs the AWS_* vars below. Bucket policy: public-read ONLY for
#          pg-images/*, keep private/* blocked.
# ----------------------------------------------------------------------------
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="storage"
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_BUCKET_NAME=""
# [OPTIONAL] CDN / custom domain in front of the bucket, e.g. https://cdn.pgconnect.site
# (also read by next.config.ts for next/image — set at build time).
AWS_PUBLIC_BASE_URL=""

# ----------------------------------------------------------------------------
# Email — Resend (OTP codes, lead alerts, verification decisions)
# Without RESEND_API_KEY emails are printed to the server log instead.
# ----------------------------------------------------------------------------
RESEND_API_KEY=""
# Must be on a domain verified in Resend.
EMAIL_FROM="PGConnect <no-reply@pgconnect.site>"

# ----------------------------------------------------------------------------
# Google — Sign in with Google + Maps/Places
# ----------------------------------------------------------------------------
# [OPTIONAL] OAuth web client ID. Server verifies ID tokens against
# GOOGLE_CLIENT_ID (falls back to NEXT_PUBLIC_GOOGLE_CLIENT_ID).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_ID=""
# [OPTIONAL] Browser key (Maps JavaScript + Places APIs). Restrict it to your
# domains in Google Cloud. Without it, map views and place autocomplete are hidden.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# [OPTIONAL] Google Search Console HTML-tag verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# ----------------------------------------------------------------------------
# Payments — Razorpay subscriptions (owner plans)
# Without key id/secret the Plans page shows plans but checkout is disabled.
# ----------------------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Secret configured on the webhook (Dashboard → Webhooks) pointing at
#   https://<your-domain>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=""
# Plan IDs (plan_xxx) for the monthly Growth (BASIC) and Pro (PREMIUM) plans.
RAZORPAY_BASIC_PLAN_ID=""
RAZORPAY_PREMIUM_PLAN_ID=""

# ----------------------------------------------------------------------------
# Realtime chat — socket-server (optional; chat falls back to polling)
# ----------------------------------------------------------------------------
# Browser-facing URL of the socket server (build time).
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
# Server-to-server URL used to push events (defaults to NEXT_PUBLIC_SOCKET_URL).
SOCKET_INTERNAL_URL="http://localhost:4000"
# Shared secret for POST /internal/emit — same value on the socket server.
SOCKET_INTERNAL_SECRET=""

# ----------------------------------------------------------------------------
# Socket server only (read by socket-server when it shares this file, e.g. in
# docker-compose). See socket-server/.env.example.
# ----------------------------------------------------------------------------
# Allowed browser origins, comma-separated.
CLIENT_ORIGIN="http://localhost:3000"
# [OPTIONAL] debug | info | warn | error
LOG_LEVEL="info"
# [OPTIONAL] Per-socket event rate limit.
SOCKET_EVENTS_PER_SECOND="10"

# ----------------------------------------------------------------------------
# Ops / tooling
# ----------------------------------------------------------------------------
# Docker image only: run `prisma migrate deploy` on container start.
RUN_MIGRATIONS="false"
# prisma/seed.ts refuses to run when NODE_ENV=production unless this is "true".
SEED_FORCE="false"
