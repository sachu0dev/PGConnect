# Port the HTTP + Socket.IO server listens on.
PORT=4000

# Must be the SAME secret next-app uses to sign access tokens (HS256).
JWT_SECRET=change-me-to-a-long-random-string

# Same Postgres database as next-app (used to authorise room joins).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pgconnect

# Comma-separated list of allowed browser origins.
CLIENT_ORIGIN=http://localhost:3000

# Shared secret for POST /internal/emit (next-app sets the same value in
# SOCKET_INTERNAL_SECRET and points SOCKET_INTERNAL_URL at this server).
SOCKET_INTERNAL_SECRET=change-me-to-another-long-random-string
